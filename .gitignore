# =============================================================================
# web-site — .gitignore
# Static site served via GitHub Pages.
# No build step today, but ignoring common frontend artifacts for the future.
# =============================================================================

# --- Node / npm (if a build tool is added later) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn/

# --- Build output ---
dist/
build/
.next/
.nuxt/
out/

# --- Environment files ---
# The GitHub OAuth client ID is public (it's in the JS source), but the
# client SECRET must NEVER be committed — it stays in GitHub Secrets only.
.env
.env.*
.env.local
.env.production

# --- Logs ---
*.log

# --- OS artifacts ---
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*~

# --- Editor / IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- Temporary files ---
*.tmp
*.bak
*.orig
